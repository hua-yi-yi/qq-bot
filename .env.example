# ============ NoneBot 基础配置 ============
# FastAPI 驱动：提供 HTTP + WebSocket 服务器（OneBot 反向 WS 由 NapCat 主动连进来）
DRIVER=~fastapi
# 监听地址：0.0.0.0 允许 Windows 侧(NapCat)通过 localhost 转发连进来
HOST=0.0.0.0
PORT=8080

# ============ 大模型配置（OpenAI 兼容接口）============
# 默认走「硅基流动 SiliconFlow」的免费模型（个人聊天够用；有速率限制）
# ① 硅基流动（免费模型）：
#    1. 注册：https://cloud.siliconflow.cn （手机号即可，不充值也能用免费模型）
#    2. 创建 API Key：控制台 → API 密钥（https://cloud.siliconflow.cn/account/ak）
#    3. 免费模型 id 以控制台「模型广场」里标注【免费】的为准（页面可能变动）
#       下面给的是长期免费的中杯模型，若报"模型不存在"，去模型广场抄一个免费模型 id 替换
# ② DeepSeek（便宜、效果强，需充值）：key 到 https://platform.deepseek.com 申请
#     LLM_BASE_URL=https://api.deepseek.com/v1
#     LLM_MODEL=deepseek-chat
# ③ OpenAI：
#     LLM_BASE_URL=https://api.openai.com/v1
#     LLM_MODEL=gpt-4o-mini

LLM_API_KEY=sk-在这里粘贴你的Key
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash
# 单次回复最大 token 数（越大回复越长、越费钱）
LLM_MAX_TOKENS=1024

# 群聊里：不 @ 机器人时，以这些词开头也会触发（逗号分隔；留空则必须 @）
GROUP_TRIGGERS=AI
